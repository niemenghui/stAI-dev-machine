# ---------- Stage 1: Builder ----------
FROM node:20 AS builder

# Accept GitHub token for private packages
ARG GITHUB_TOKEN
ENV GITHUB_TOKEN=${GITHUB_TOKEN}

WORKDIR /usr/src/app

# Copy dependency manifests + .npmrc from the express workspace
COPY nq-express/package.json .npmrc ./

# Install all dependencies (including dev)
RUN npm install && rm -f .npmrc

# Copy full express workspace source
COPY nq-express/ ./

# Build if needed (TS or bundler)
RUN npm run build --if-present


# ---------- Stage 2: Runtime ----------
FROM node:20-slim AS runtime

# Accept GitHub token again for private packages
ARG GITHUB_TOKEN
ENV GITHUB_TOKEN=${GITHUB_TOKEN}

ENV NODE_ENV=production
WORKDIR /usr/src/app

# Copy only package.json + .npmrc for production install
COPY nq-express/package.json .npmrc ./

# Install only production dependencies
RUN npm install --omit=dev && rm -f .npmrc

# Copy runtime files from builder
COPY --from=builder /usr/src/app/bin ./bin
COPY --from=builder /usr/src/app/app.js ./
COPY --from=builder /usr/src/app/config ./config
COPY --from=builder /usr/src/app/controllers ./controllers
COPY --from=builder /usr/src/app/daos ./daos
COPY --from=builder /usr/src/app/data ./data
COPY --from=builder /usr/src/app/factories ./factories
COPY --from=builder /usr/src/app/middlewares ./middlewares
COPY --from=builder /usr/src/app/models ./models
COPY --from=builder /usr/src/app/routes ./routes
COPY --from=builder /usr/src/app/services ./services
COPY --from=builder /usr/src/app/utils ./utils
COPY --from=builder /usr/src/app/views ./views
COPY --from=builder /usr/src/app/public ./public
COPY --from=builder /usr/src/app/uploads ./uploads

EXPOSE 5000
CMD ["node", "./bin/www"]
